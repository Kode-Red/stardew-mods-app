{
  "name": "@sdm/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Stardew Mod Manager desktop app (Electron + Vue + Nuxt UI).",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && node scripts/pack.mjs",
    "dist:win": "electron-vite build && node scripts/pack.mjs",
    "pack:win": "electron-vite build && node scripts/pack.mjs --dir",
    "release:win": "electron-vite build && node scripts/pack.mjs --publish",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck": "pnpm run typecheck:node",
    "test": "vitest run",
    "clean": "rimraf out release .turbo"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@sdm/core": "workspace:*",
    "fflate": "^0.8.3",
    "@nuxt/ui": "^3.0.0",
    "@types/node": "^22.10.7",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  }
}
